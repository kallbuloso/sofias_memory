# Application
APP_NAME=Sofias Memory
APP_ENV=development
APP_VERSION=0.1.2
API_KEY=sf-change-me-with-at-least-32-random-characters
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_MB=50
REQUEST_WAIT_TIMEOUT_SECONDS=30

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://sofias_memory:change-me@postgres:5432/sofias_memory
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Local storage
# DATA_DIRECTORY remains mandatory persistent application state in BOTH
# STORAGE_BACKEND modes below -- it is never optional under S3 (ADR-0011 D1/
# D22): durable Remember ingress, crash-recovery inputs, and in-transit
# filesystem->S3 migration state all live here regardless of where finalized
# Source originals end up.
DATA_DIRECTORY=/data/sources
TEMP_DIRECTORY=/data/tmp
MAX_SOURCE_SIZE_MB=50

# Source-original object storage backend (ADR-0011). filesystem (default) ->
# new Source originals are written under DATA_DIRECTORY, exactly as today.
# s3 -> new Source originals are written to the S3 bucket/prefix below, and
# any existing file:// Sources are migrated to S3 automatically at startup
# (no manual migration command). Reads/deletes of an existing Source always
# follow its own storage_uri scheme, never this setting -- switching this
# back to filesystem does NOT move s3:// Sources back (no reverse migration).
STORAGE_BACKEND=filesystem

# The four S3 fields below are only required when STORAGE_BACKEND=s3.
# STORAGE_S3_ACCESS_KEY_ID/STORAGE_S3_SECRET_ACCESS_KEY/
# STORAGE_S3_SESSION_TOKEN are OPTIONAL even under STORAGE_BACKEND=s3 -- leave
# them unset to use the standard AWS credential provider chain (environment,
# shared config file, container/instance role) instead of static credentials.
# STORAGE_S3_ENDPOINT_URL is only needed for an S3-compatible endpoint (e.g.
# MinIO) or a non-default AWS partition; leave unset for standard AWS S3.
# STORAGE_S3_PREFIX is an application-managed namespace Sofias Memory must be
# the exclusive writer of (ADR-0011 D36) -- it may share a bucket with other
# applications under a different prefix, but never the same prefix.
# STORAGE_S3_BUCKET=
# STORAGE_S3_PREFIX=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_SESSION_TOKEN=
# STORAGE_S3_MAX_CONCURRENCY=4

# LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-change-me
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4

# Embeddings
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CONCURRENCY=4

# Chunking
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=120
CHUNK_MIN_TOKENS=40

# Retrieval
RECALL_VECTOR_TOP_K=50
RECALL_LEXICAL_TOP_K=50
RECALL_GRAPH_SEED_TOP_K=10
RECALL_GRAPH_DEPTH=2
RECALL_GRAPH_MAX_NODES=100
RECALL_DEFAULT_TOP_K=12
RECALL_MAX_TOP_K=100
RECALL_RRF_K=60

# Graph / provenance
GRAPH_SUBGRAPH_MAX_DEPTH=3
GRAPH_SUBGRAPH_MAX_RELATIONS=200
GRAPH_PATH_MAX_DEPTH=4
PROVENANCE_MAX_EVIDENCE=50

# Improve
ENTITY_DEDUP_SIMILARITY_THRESHOLD=0.90
ENTITY_MERGE_SIMILARITY_THRESHOLD=0.95

# Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=500
WORKER_STALE_AFTER_SECONDS=300
WORKER_MAX_CONCURRENT_DATASETS=1
WORKER_MAX_CONCURRENT_READS=8

# Privacy
STORE_QUERY_CONTENT=true
LOG_DOCUMENT_CONTENT=false
LOG_LLM_PAYLOADS=false
